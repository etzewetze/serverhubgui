<project xmlns="http://maven.apache.org/POM/4.0.0"><modelVersion>4.0.0</modelVersion>
  <parent><groupId>de.serverhub</groupId><artifactId>serverhub-parent</artifactId><version>2.2.0</version></parent>
  <artifactId>ServerHub-Velocity</artifactId>
  <dependencies>
    <dependency><groupId>de.serverhub</groupId><artifactId>serverhub-common</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>com.velocitypowered</groupId><artifactId>velocity-api</artifactId><version>4.2.0</version><scope>provided</scope></dependency>
    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
    <dependency><groupId>org.mockito</groupId><artifactId>mockito-core</artifactId><version>5.18.0</version><scope>test</scope></dependency>
  </dependencies>
  <build><resources><resource><directory>src/main/resources</directory></resource><resource><directory>../resource-pack-output</directory><includes><include>serverhub-pack.zip</include></includes></resource></resources>
    <plugins>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><configuration><argLine>${test.jvm.args} -javaagent:${settings.localRepository}/org/mockito/mockito-core/5.18.0/mockito-core-5.18.0.jar</argLine></configuration></plugin>
    </plugins>
  </build>
</project>
